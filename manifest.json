{
  "$schema": "./schema/protocol-manifest.schema.json",
  "id": "unflatten-protocol",
  "version": "0.1.0",
  "protocol": "docs/protocol.md",
  "handoff": "docs/handoff.md",
  "roles": {
    "innovator": {
      "alias": "@ino",
      "template": "prompt-templates/core/innovator.md",
      "kind": "core"
    },
    "auditor": {
      "alias": "@aud",
      "template": "prompt-templates/core/auditor.md",
      "kind": "core"
    },
    "engineer": {
      "alias": "@eng",
      "template": "prompt-templates/core/engineer.md",
      "kind": "core"
    },
    "integrator": {
      "alias": "@int",
      "template": "prompt-templates/core/integrator.md",
      "kind": "core"
    },
    "exit-designer": {
      "alias": "@ext",
      "aliases": ["@out"],
      "template": "prompt-templates/extensions/exit-designer.md",
      "kind": "extension"
    },
    "entropy-harvester": {
      "alias": "@ent",
      "template": "prompt-templates/extensions/entropy-harvester.md",
      "kind": "extension"
    },
    "alien-proxy": {
      "alias": "@aln",
      "template": "prompt-templates/extensions/alien-proxy.md",
      "kind": "extension"
    },
    "mesh-scaler": {
      "alias": "@scl",
      "template": "prompt-templates/extensions/mesh-scaler.md",
      "kind": "extension"
    },
    "meta-protocol-designer": {
      "alias": "@met",
      "template": "prompt-templates/meta/meta-protocol-designer.md",
      "kind": "meta"
    }
  },
  "engines": {
    "role-invention": "prompt-templates/meta/protocol-invention-engine.md"
  },
  "schemas": {
    "protocol-manifest": "schema/protocol-manifest.schema.json",
    "handoff": "schema/handoff-contract.schema.json",
    "state-history": "schema/state-history.schema.json",
    "audit-report": "schema/audit-report.schema.json"
  }
}
