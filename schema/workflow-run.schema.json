{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schema/workflow-run.schema.json",
  "title": "Unflatten Workflow Run",
  "type": "object",
  "required": ["run_id", "protocol_version", "current_role", "current_handoff", "status", "history"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "minLength": 1 },
    "current_role": { "type": "string", "minLength": 1 },
    "current_handoff": { "type": "object" },
    "status": { "enum": ["active", "hold", "complete"] },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "at", "from_role", "to_role", "route", "reason", "authority", "protocol_digest", "role_digest", "handoff_digest", "previous_entry_digest", "entry_digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "from_role": { "type": "string", "minLength": 1 },
          "to_role": { "type": "string", "minLength": 1 },
          "route": { "enum": ["advisory", "deviation"] },
          "reason": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["not_evaluated", "epistemic_recommendation", "operational_decision", "implementation_report", "advisory_observation"] },
          "protocol_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "role_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "handoff_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "previous_entry_digest": { "anyOf": [{ "const": "genesis" }, { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }] },
          "entry_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "artifact_ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
