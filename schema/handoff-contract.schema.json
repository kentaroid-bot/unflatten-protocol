{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schema/handoff-contract.schema.json",
  "title": "Unflatten Handoff Contract",
  "type": "object",
  "required": ["handoff"],
  "properties": {
    "handoff": {
      "type": "object",
      "required": ["protocol_version", "from_role", "to_role", "reason", "inquiry", "hypothesis", "hypothetical_world", "evaluation", "decision", "pivot", "epistemic_remainder", "next_step"],
      "properties": {
        "protocol_version": { "type": "string", "minLength": 1 },
        "from_role": { "type": "string", "minLength": 1 },
        "to_role": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "inquiry": { "$ref": "#/$defs/inquiry" },
        "hypothesis": { "$ref": "#/$defs/hypothesis" },
        "hypothetical_world": { "$ref": "#/$defs/hypotheticalWorld" },
        "evaluation": { "$ref": "#/$defs/evaluation" },
        "decision": { "$ref": "#/$defs/decision" },
        "pivot": { "$ref": "#/$defs/pivot" },
        "epistemic_remainder": { "$ref": "#/$defs/epistemicRemainder" },
        "next_step": { "$ref": "#/$defs/nextStep" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "inquiry": {
      "type": "object",
      "required": ["problem_tension", "current_question", "distinct_dimensions", "flattening_risks"],
      "properties": {
        "problem_tension": { "$ref": "#/$defs/nonEmptyString" },
        "current_question": { "$ref": "#/$defs/nonEmptyString" },
        "distinct_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "significance"],
            "properties": {
              "dimension": { "$ref": "#/$defs/nonEmptyString" },
              "significance": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "flattening_risks": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "hypothesis": {
      "type": "object",
      "required": ["statement", "core_claims", "mechanism", "assumptions", "scope"],
      "properties": {
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "core_claims": { "$ref": "#/$defs/nonEmptyStringArray" },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assumption", "status"],
            "properties": {
              "assumption": { "$ref": "#/$defs/nonEmptyString" },
              "status": { "enum": ["supported", "contradicted", "unknown"] }
            }
          }
        },
        "scope": {
          "type": "object",
          "required": ["applies_to", "does_not_apply_to"],
          "properties": {
            "applies_to": { "$ref": "#/$defs/stringArray" },
            "does_not_apply_to": { "$ref": "#/$defs/stringArray" }
          }
        }
      }
    },
    "hypotheticalWorld": {
      "type": "object",
      "required": ["description", "consequences", "opportunities"],
      "properties": {
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "consequences": {
          "type": "object",
          "required": ["primary", "secondary", "tertiary"],
          "properties": {
            "primary": { "$ref": "#/$defs/stringArray" },
            "secondary": { "$ref": "#/$defs/stringArray" },
            "tertiary": { "$ref": "#/$defs/stringArray" }
          }
        },
        "opportunities": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["falsifiers", "evidence", "tests_completed", "tests_remaining"],
      "properties": {
        "falsifiers": { "$ref": "#/$defs/nonEmptyStringArray" },
        "evidence": {
          "type": "object",
          "required": ["supporting", "contradicting", "unknown"],
          "properties": {
            "supporting": { "$ref": "#/$defs/stringArray" },
            "contradicting": { "$ref": "#/$defs/stringArray" },
            "unknown": { "$ref": "#/$defs/stringArray" }
          }
        },
        "tests_completed": { "$ref": "#/$defs/stringArray" },
        "tests_remaining": { "$ref": "#/$defs/stringArray" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "authority", "decided_by", "rationale", "preserved_dimensions", "rejected_claims", "revisions"],
      "properties": {
        "status": { "enum": ["advance", "revise", "replace", "hold", "not_evaluated"] },
        "authority": { "enum": ["not_evaluated", "epistemic_recommendation", "operational_decision", "implementation_report", "advisory_observation"] },
        "decided_by": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "preserved_dimensions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "rejected_claims": { "$ref": "#/$defs/stringArray" },
        "revisions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "pivot": {
      "type": "object",
      "required": ["trigger", "learned_structure", "pivot_seeds", "next_hypothesis"],
      "properties": {
        "trigger": { "type": "string" },
        "learned_structure": { "$ref": "#/$defs/stringArray" },
        "pivot_seeds": { "$ref": "#/$defs/stringArray" },
        "next_hypothesis": { "type": "string" }
      }
    },
    "epistemicRemainder": {
      "type": "object",
      "required": ["residuals", "dissent"],
      "properties": {
        "residuals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["observation", "schema_limit", "provenance", "review_when"],
            "properties": {
              "observation": { "$ref": "#/$defs/nonEmptyString" },
              "schema_limit": { "$ref": "#/$defs/nonEmptyString" },
              "provenance": { "$ref": "#/$defs/nonEmptyString" },
              "review_when": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "dissent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "holder", "unresolved_because"],
            "properties": {
              "position": { "$ref": "#/$defs/nonEmptyString" },
              "holder": { "$ref": "#/$defs/nonEmptyString" },
              "unresolved_because": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "nextStep": {
      "type": "object",
      "required": ["objective", "constraints", "expected_output", "unresolved_questions"],
      "properties": {
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "expected_output": { "$ref": "#/$defs/stringArray" },
        "unresolved_questions": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
