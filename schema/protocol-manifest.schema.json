{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unflatten.dev/schema/protocol-manifest.schema.json",
  "title": "Unflatten Protocol Manifest",
  "type": "object",
  "required": ["id", "version", "protocol", "ingress", "handoff", "roles", "schemas"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "const": "unflatten-protocol" },
    "version": { "type": "string", "minLength": 1 },
    "protocol": { "type": "string", "minLength": 1 },
    "ingress": { "type": "string", "minLength": 1 },
    "handoff": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "required": ["alias", "template", "kind", "authority"],
        "properties": {
          "alias": { "type": "string", "pattern": "^@[a-z]+$" },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^@[a-z]+$" }, "uniqueItems": true },
          "template": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["core", "extension", "meta"] },
          "authority": { "enum": ["not_evaluated", "epistemic_recommendation", "operational_decision", "implementation_report", "advisory_observation"] }
        },
        "additionalProperties": false
      }
    },
    "engines": { "type": "object", "additionalProperties": { "type": "string" } },
    "workflow": {
      "type": "object",
      "required": ["mode", "routes"],
      "properties": {
        "mode": { "const": "advisory" },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      },
      "additionalProperties": false
    },
    "worldlines": { "type": "string", "pattern": "^worldlines/[A-Za-z0-9._/-]+\\.json$" },
    "schemas": {
      "type": "object",
      "required": ["handoff", "state-history", "audit-report"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
